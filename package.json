{
  "name": "explainer-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply explainer-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply explainer-db --remote",
    "container:build": "docker build -f container/Dockerfile -t explainer-container .",
    "phase1": "pwsh -File scripts/phase1-local.ps1"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.30",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.20.0"
  }
}
