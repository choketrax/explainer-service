{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "explainer-service",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Internal-only: no routes, no workers.dev. Callers use Service Bindings
  // (entrypoint "ExplainerService"). See docs/INTEGRATION.md.
  "workers_dev": false,
  "preview_urls": false,

  "durable_objects": {
    "bindings": [{ "name": "EXPLAINER_CONTAINER", "class_name": "ExplainerContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ExplainerContainer"] }],

  "containers": [
    {
      "class_name": "ExplainerContainer",
      "image": "./container/Dockerfile",
      "image_build_context": ".",
      "instance_type": "standard-3", // Chromium + Remotion needs RAM; verify sizing in Phase 2
      "max_instances": 10 // global render pool bound
    }
  ],

  "workflows": [
    { "name": "explainer-workflow", "binding": "EXPLAINER_WORKFLOW", "class_name": "ExplainerWorkflow" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "explainer-db",
      "database_id": "4a471fd3-1228-48a1-a05a-35838fa56ed2",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "explainer-assets" }],

  "vars": {
    "R2_ACCOUNT_ID": "56e8d68c2c46720b0d77df12d63da7e2",
    "R2_BUCKET_NAME": "explainer-assets",
    "AI_GATEWAY_BASE_URL": "https://api.deepseek.com",
    "ALLOWED_EGRESS_HOSTS": "registry.npmjs.org,pypi.org,files.pythonhosted.org,en.wikipedia.org,arxiv.org",
    "PRESIGN_TTL_SECONDS": "900",
    // Logical model roles -> provider model ids (routed via AI Gateway)
    "MODEL_RESEARCH": "deepseek-chat",
    "MODEL_SCRIPT": "gpt-4o",
    "MODEL_SCENE": "gpt-4o",
    "MODEL_QC": "gpt-4o",
    "MODEL_QC_ESCALATION": "gpt-4o",
    "MODEL_REVISION": "gpt-4o",
    "DEFAULT_APPROVAL_MODE": "preview"
  }

  // Secrets (wrangler secret put): AI_GATEWAY_TOKEN, ANTHROPIC_API_KEY, OPENAI_API_KEY, DEEPSEEK_API_KEY
  // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, EXTERNAL_API_KEYS (JSON, optional)
}
